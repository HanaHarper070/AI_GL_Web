                    'ก. อัปโหลดไฟล์รายชื่อผู้ป่วยติดเตียงพร้อมเลขบัตรประชาชน 13 หลักให้ AI จัดหมวดหมู่',
                    'ข. นำเอกสารลับมากของทางราชการไปให้ AI สรุปย่อเพื่อความรวดเร็ว',
                    'ค. ปกปิดชื่อ-นามสกุล เลขบัตรประชาชน และเบอร์โทรศัพท์ โดยแทนที่ด้วยสัญลักษณ์ [ปกปิดข้อมูล] ก่อนป้อนเข้าสู่ระบบ AI',
                    'ง. โพสต์ประกาศรายชื่อผู้ค้างชำระภาษีพร้อมเบอร์โทรศัพท์ส่วนตัวขึ้นเพจ Facebook ทันทีที่ AI ร่างเสร็จ'
                ],
                correct: 2,
                explanation: 'การทำ Data Anonymization (ปกปิดข้อมูลระบุตัวตนและข้อมูลอ่อนไหว) ก่อนป้อนเข้าสู่ AI สาธารณะ เป็นหลักปฏิบัติสำคัญเพื่อไม่ให้ละเมิด PDPA'
            },
            {
                q: '4. ภาวะ "AI Hallucination" ในบริบทงานราชการหมายถึงข้อใด และเจ้าหน้าที่ควรรับมืออย่างไร?',
                options: [
                    'ก. AI ทำงานช้าลงเมื่อมีผู้ใช้งานพร้อมกันจำนวนมาก',
                    'ข. AI แต่งข้อมูลเท็จหรืออ้างอิงเลขมาตรา/ระเบียบกระทรวงมหาดไทยที่ไม่มีอยู่จริง จึงต้องมีเจ้าหน้าที่ตรวจสอบกับต้นฉบับจริงเสมอ (Human-in-the-Loop)',
                    'ค. AI ปฏิเสธการเขียนคำกล่าวเปิดงานให้กับผู้บริหาร',
                    'ง. AI สร้างภาพอินโฟกราฟิกที่มีสีสันสดใสเกินไป'
                ],
                correct: 1,
                explanation: 'Generative AI อาจสร้างข้อความที่ดูน่าเชื่อถือแต่อ้างอิงข้อกฎหมายที่คลาดเคลื่อน เจ้าหน้าที่ผู้รับผิดชอบจึงต้องตรวจสอบ (Fact-Checking) กับระเบียบฉบับจริงก่อนเสนอลงนามทุกครั้ง'
            },
            {
                q: '5. ในการออกแบบกระบวนการทำงานใหม่ (Workflow Redesign) โดยมี AI เป็นผู้ช่วย แนวคิด "Human-in-the-Loop" มีความสำคัญอย่างไร?',
                options: [
                    'ก. ให้ AI ตัดสินใจอนุมัติงบประมาณแทนผู้บริหารทั้งหมด',
                    'ข. ให้เจ้าหน้าที่ทำหน้าที่ตรวจสอบ คัดกรอง และควบคุมคุณภาพความถูกต้องของงานที่ได้จาก AI ก่อนนำไปใช้ในราชการ',
                    'ค. ให้ประชาชนเป็นผู้เขียนบันทึกข้อความราชการด้วยตนเอง',
                    'ง. ยกเลิกการตรวจสอบเอกสารตามระเบียบพัสดุเพื่อความรวดเร็ว'
                ],
                correct: 1,
                explanation: 'AI เป็นเพียงผู้ช่วยลดเวลาการร่างและสกัดข้อมูล แต่ความรับผิดชอบทางกฎหมายและความถูกต้องตามระเบียบยังคงเป็นของเจ้าหน้าที่ผู้ปฏิบัติงาน (Human-in-the-Loop)'
            }
        ];

        // ==========================================
        // 3. STATE MANAGEMENT
        // ==========================================
        let currentModuleIndex = 0;
        let currentWorkshopTab = 'overview';
        let completedModules = new Set(['ws1']);
        let isPresentationMode = false;
        let userQuizAnswers = {};

        // ==========================================
        // 4. CORE RENDER FUNCTIONS
        // ==========================================
        function initApp() {
            renderSidebar();
            renderCurrentModule();
            renderQuiz();
            fillBuilderSample();
            updateProgressUI();
            lucide.createIcons();
        }

        function renderSidebar(filterText = '') {
            const navList = document.getElementById('module-nav-list');
            navList.innerHTML = '';

            const normalizedFilter = filterText.trim().toLowerCase();

            workshopsData.forEach((mod, idx) => {
                // Check search filter across title, topics, and prompts
                const matchTitle = mod.title.toLowerCase().includes(normalizedFilter);
                const matchTopics = mod.topics.some(t => t.toLowerCase().includes(normalizedFilter));
                const matchPrompts = mod.prompts.some(p => 
                    p.title.toLowerCase().includes(normalizedFilter) ||
                    p.task.toLowerCase().includes(normalizedFilter) ||
                    p.context.toLowerCase().includes(normalizedFilter)
                );

                if (normalizedFilter && !matchTitle && !matchTopics && !matchPrompts) {
                    return;
                }

                const isActive = idx === currentModuleIndex;
                const isDone = completedModules.has(mod.id);

                const btn = document.createElement('button');
                btn.onclick = () => {
                    switchMainView('workshop');
                    selectModule(idx);
                    if (window.innerWidth < 1024) toggleMobileSidebar();
                };
                btn.className = `w-full text-left p-3 rounded-xl transition flex items-start gap-3 group ${
                    isActive 
                        ? 'bg-gov-800 text-white shadow-sm' 
                        : 'hover:bg-slate-100 text-slate-700'
                }`;

                btn.innerHTML = `
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5 ${
                        isActive ? 'bg-amber-400 text-slate-950' : isDone ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600 group-hover:bg-white'
                    }">
                        <i data-lucide="${isDone && !isActive ? 'check' : mod.icon}" class="w-4 h-4"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-1">
                            <span class="text-[11px] font-heading font-semibold uppercase tracking-wide ${
                                isActive ? 'text-amber-300' : 'text-slate-400'
                            }">${mod.code}</span>
                            <span class="text-[11px] px-1.5 py-0.2 rounded ${
                                isActive ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-500'
                            }">${mod.prompts.length} Prompt</span>
                        </div>
                        <p class="font-heading font-semibold text-sm truncate mt-0.5">${mod.shortTitle}</p>
                    </div>
                `;
                navList.appendChild(btn);
            });

            lucide.createIcons();
        }

        function selectModule(index) {
            currentModuleIndex = index;
            renderSidebar(document.getElementById('search-input').value);
            renderCurrentModule();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function navigateModule(direction) {
            const nextIdx = currentModuleIndex + direction;
            if (nextIdx >= 0 && nextIdx < workshopsData.length) {
                selectModule(nextIdx);
            }
        }

        function renderCurrentModule() {
            const mod = workshopsData[currentModuleIndex];

            // Header Banner
            document.getElementById('module-badge').textContent = mod.code;
            document.getElementById('module-title').textContent = mod.title;
            document.getElementById('module-description').textContent = mod.description;

            // Complete Button status
            const completeBtn = document.getElementById('btn-complete-module');
            if (completedModules.has(mod.id)) {
                completeBtn.innerHTML = `<i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-300"></i><span>เรียนจบหัวข้อนี้แล้ว</span>`;
                completeBtn.className = "flex items-center gap-1.5 text-xs font-heading px-3 py-1.5 rounded-lg bg-emerald-500/30 border border-emerald-400/40 text-white backdrop-blur-xs transition";
            } else {
                completeBtn.innerHTML = `<i data-lucide="square" class="w-4 h-4"></i><span>ทำเครื่องหมายว่าเรียนจบหัวข้อนี้</span>`;
                completeBtn.className = "flex items-center gap-1.5 text-xs font-heading px-3 py-1.5 rounded-lg bg-white/15 hover:bg-white/25 text-white backdrop-blur-xs transition";
            }

            // Badge count on tab
            document.getElementById('prompt-count-badge').textContent = mod.prompts.length;

            // 1. Topics List
            const topicsList = document.getElementById('module-topics-list');
            topicsList.innerHTML = mod.topics.map(t => `
                <li class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-100 text-slate-700 text-sm">
                    <i data-lucide="check-circle" class="w-4 h-4 text-blue-600 shrink-0 mt-0.5"></i>
                    <span>${t}</span>
                </li>
            `).join('');

            // 2. Special 6 Types of Gov Docs (Only Workshop 1)
            const govDocsSection = document.getElementById('special-gov-docs-section');
            if (mod.hasGovDocsSection && mod.govDocTypes) {
                govDocsSection.classList.remove('hidden');
                const grid = document.getElementById('gov-doc-types-grid');
                grid.innerHTML = mod.govDocTypes.map(doc => `
                    <div onclick="jumpToPrompt(${doc.promptIndex})" class="cursor-pointer group p-4 rounded-xl border border-slate-200 hover:border-blue-500 bg-slate-50/70 hover:bg-blue-50/40 transition flex flex-col justify-between space-y-3">
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-heading font-bold text-sm text-gov-800 group-hover:text-blue-700">${doc.num}</span>
                                <i data-lucide="arrow-up-right" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition"></i>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">${doc.desc}</p>
                        </div>
                        <div class="pt-2 border-t border-slate-200/70 flex items-center gap-1.5 text-[11px] text-amber-800 font-medium">
                            <i data-lucide="file-badge" class="w-3.5 h-3.5 text-amber-600 shrink-0"></i>
                            <span class="truncate">${doc.paper}</span>
                        </div>
                    </div>
                `).join('');
            } else {
                govDocsSection.classList.add('hidden');
            }

            // 3. 1x1 Prompt Structure Table
            document.getElementById('structure-table-header').textContent = mod.structureTitle;
            const structBody = document.getElementById('structure-table-body');
            structBody.innerHTML = mod.structureItems.map((item, i) => `
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
                    <span class="font-heading font-bold text-indigo-950 shrink-0">• ${item.label}:</span>
                    <span class="text-slate-700">${item.text}</span>
                </div>
            `).join('');

            // 4. 1x1 Prompt Examples Table
            const promptsContainer = document.getElementById('prompts-list-container');
            promptsContainer.innerHTML = mod.prompts.map((p, idx) => {
                const fullPromptText = `บทบาท: ${p.role}\nงานที่ต้องการให้ทำ: ${p.task}\nบริบทและข้อมูลสำคัญ: ${p.context}\nรูปแบบภาษาและผลลัพธ์: ${p.format}`;
                const encodedPrompt = encodeURIComponent(fullPromptText);

                return `
                <div id="prompt-card-${idx}" class="border-2 border-slate-200 hover:border-blue-300 rounded-xl overflow-hidden bg-white shadow-2xs transition">
                    <!-- 1x1 Table Header -->
                    <div class="bg-slate-800 text-white px-4 py-3 flex flex-wrap items-center justify-between gap-2">
                        <span class="font-heading font-semibold text-sm text-amber-300">${p.title}</span>
                        <div class="flex items-center gap-2">
                            ${p.link ? `
                                <a href="${p.link}" target="_blank" rel="noopener noreferrer" class="text-xs bg-white/10 hover:bg-white/20 text-white px-2.5 py-1 rounded-lg flex items-center gap-1 transition">
                                    <i data-lucide="external-link" class="w-3.5 h-3.5 text-amber-300"></i>
                                    <span>ดูตัวอย่างจริงบน Gemini</span>
                                </a>
                            ` : ''}
                            <button onclick="loadIntoBuilder(${idx})" class="text-xs bg-slate-700 hover:bg-slate-600 text-slate-200 px-2.5 py-1 rounded-lg flex items-center gap-1 transition">
                                <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                                <span>ปรับแต่งในเครื่องมือสร้าง</span>
                            </button>
                            <button onclick="copyTextDecode('${encodedPrompt}')" class="text-xs bg-amber-500 hover:bg-amber-400 text-slate-950 font-heading font-semibold px-3 py-1 rounded-lg flex items-center gap-1 transition shadow-xs">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                <span>คัดลอก Prompt</span>
                            </button>
                        </div>
                    </div>
                    <!-- 1x1 Table Single Cell Content -->
                    <div class="p-5 space-y-2.5 text-slate-800 bg-slate-50/50 prompt-box">
                        <div><strong class="font-heading text-blue-900">บทบาท:</strong> ${p.role}</div>
                        <div><strong class="font-heading text-blue-900">งานที่ต้องการให้ทำ:</strong> ${p.task}</div>
                        <div><strong class="font-heading text-blue-900">บริบทและข้อมูลสำคัญ:</strong> ${p.context}</div>
                        <div><strong class="font-heading text-blue-900">รูปแบบภาษาและผลลัพธ์:</strong> ${p.format}</div>
                    </div>
                </div>
                `;
            }).join('');

            // 5. 1x1 AI Outputs Table
            const outputsContainer = document.getElementById('outputs-list-container');
            outputsContainer.innerHTML = mod.outputs.map((out, idx) => {
                const encodedOut = encodeURIComponent(out.content);
                return `
                <div class="border-2 border-emerald-200 rounded-xl overflow-hidden bg-white shadow-2xs">
                    <div class="bg-emerald-900 text-white px-4 py-3 flex items-center justify-between gap-2">
                        <span class="font-heading font-semibold text-sm flex items-center gap-2">
                            <i data-lucide="sparkles" class="w-4 h-4 text-emerald-300"></i>
                            <span>${out.title}</span>
                        </span>
                        <button onclick="copyTextDecode('${encodedOut}', 'คัดลอกผลลัพธ์ตัวอย่างเรียบร้อยแล้ว!')" class="text-xs bg-white/15 hover:bg-white/25 text-white font-heading px-3 py-1 rounded-lg flex items-center gap-1 transition">
                            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            <span>คัดลอกผลลัพธ์</span>
                        </button>
                    </div>
                    <div class="p-5 bg-emerald-50/20 text-slate-800 whitespace-pre-line leading-relaxed text-sm sm:text-base font-sans prompt-box">${out.content}</div>
                </div>
                `;
            }).join('');

            // Pagination Buttons state
            document.getElementById('btn-prev-module').disabled = currentModuleIndex === 0;
            document.getElementById('btn-next-module').disabled = currentModuleIndex === workshopsData.length - 1;

            lucide.createIcons();
        }

        // ==========================================
        // 5. NAVIGATION & TABS LOGIC
        // ==========================================
        function switchWorkshopTab(tabName) {
            currentWorkshopTab = tabName;
            const tabs = ['overview', 'prompts', 'outputs'];
            tabs.forEach(t => {
                const contentEl = document.getElementById(`content-${t}`);
                const btnEl = document.getElementById(`tab-${t}`);
                if (t === tabName) {
                    contentEl.classList.remove('hidden');
                    btnEl.className = "workshop-tab-btn flex items-center gap-2 px-4 py-2.5 font-heading font-medium text-sm rounded-t-xl border-b-2 border-blue-600 text-blue-700 bg-blue-50/60 whitespace-nowrap";
                } else {
                    contentEl.classList.add('hidden');
                    btnEl.className = "workshop-tab-btn flex items-center gap-2 px-4 py-2.5 font-heading font-medium text-sm rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 hover:bg-slate-100 whitespace-nowrap";
                }
            });
            lucide.createIcons();
        }

        function jumpToPrompt(promptIndex) {
            switchWorkshopTab('prompts');
            setTimeout(() => {
                const card = document.getElementById(`prompt-card-${promptIndex}`);
                if (card) {
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    card.classList.add('ring-4', 'ring-amber-400');
                    setTimeout(() => card.classList.remove('ring-4', 'ring-amber-400'), 2200);
                }
            }, 100);
        }

        function switchMainView(viewName) {
            const views = ['workshop', 'builder', 'quiz'];
            views.forEach(v => {
                const el = document.getElementById(`view-${v}`);
                if (v === viewName) {
                    el.classList.remove('hidden');
                } else {
                    el.classList.add('hidden');
                }
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
            lucide.createIcons();
        }

        function toggleMobileSidebar() {
            const sb = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            const isHidden = sb.classList.contains('-translate-x-full');
            if (isHidden) {
                sb.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sb.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        function togglePresentationMode() {
            isPresentationMode = !isPresentationMode;
            const sb = document.getElementById('sidebar');
            const mainContent = document.getElementById('main-content');
            const btn = document.getElementById('presentation-btn');

            if (isPresentationMode) {
                sb.classList.add('lg:hidden');
                mainContent.classList.add('presentation-zoom');
                btn.classList.replace('bg-slate-800', 'bg-amber-500');
                btn.classList.replace('text-slate-300', 'text-slate-950');
                showToast('เปิดโหมดบรรยายสำหรับวิทยากร (ขยายตัวอักษร)');
            } else {
                sb.classList.remove('lg:hidden');
                mainContent.classList.remove('presentation-zoom');
                btn.classList.replace('bg-amber-500', 'bg-slate-800');
                btn.classList.replace('text-slate-950', 'text-slate-300');
                showToast('ปิดโหมดบรรยาย');
            }
        }

        function handleSearch(val) {
            renderSidebar(val);
        }

        function markModuleComplete() {
            const mod = workshopsData[currentModuleIndex];
            if (completedModules.has(mod.id)) {
                completedModules.delete(mod.id);
            } else {
                completedModules.add(mod.id);
                showToast(`บันทึกความคืบหน้า: เรียนจบ ${mod.code} แล้ว!`);
            }
            updateProgressUI();
            renderSidebar(document.getElementById('search-input').value);
            renderCurrentModule();
        }

        function updateProgressUI() {
            const total = workshopsData.length;
            const done = completedModules.size;
            const pct = Math.round((done / total) * 100);
            document.getElementById('progress-bar').style.width = `${pct}%`;
            document.getElementById('progress-text').textContent = `${done}/${total}`;
        }

        // ==========================================
        // 6. INTERACTIVE PROMPT BUILDER LOGIC
        // ==========================================
        function setBuilderField(id, value) {
            document.getElementById(id).value = value;
            updateLivePrompt();
        }

        function fillBuilderSample() {
            document.getElementById('builder-role').value = 'นักจัดการงานทั่วไปชำนาญการ สังกัดสำนักปลัด เทศบาลตำบลเมืองใหม่';
            document.getElementById('builder-task').value = 'ร่างหนังสือภายใน (บันทึกข้อความ) เสนอต่อนายกเทศมนตรีตำบลเมืองใหม่';
            document.getElementById('builder-context').value = 'เรื่อง ขออนุมัติจัดโครงการฝึกอบรมการใช้ AI ในงานราชการ ประจำปีงบประมาณ พ.ศ. 2569 ในวันศุกร์ที่ 15 พฤศจิกายน 2569 ณ ห้องประชุมเทศบาลฯ กลุ่มเป้าหมายคือพนักงานเทศบาลจำนวน 50 คน งบประมาณ 15,000 บาท';
            document.getElementById('builder-format').value = 'ใช้ภาษาราชการที่ถูกต้องตามระเบียบงานสารบรรณ แบ่งเนื้อหาเป็น 1. เรื่องเดิม 2. ข้อเท็จจริง 3. ข้อพิจารณาและข้อเสนอ';
            updateLivePrompt();
        }

        function resetBuilder() {
            document.getElementById('builder-role').value = '';
            document.getElementById('builder-task').value = '';
            document.getElementById('builder-context').value = '';
            document.getElementById('builder-format').value = '';
            updateLivePrompt();
        }

        function loadIntoBuilder(promptIdx) {
            const mod = workshopsData[currentModuleIndex];
            const p = mod.prompts[promptIdx];
            if (!p) return;

            document.getElementById('builder-role').value = p.role;
            document.getElementById('builder-task').value = p.task;
            document.getElementById('builder-context').value = p.context;
            document.getElementById('builder-format').value = p.format;
            updateLivePrompt();
            switchMainView('builder');
            showToast('โหลดตัวอย่างเข้าสู่เครื่องมือสร้าง Prompt แล้ว ปรับแก้ข้อมูลได้ทันที!');
        }

        function updateLivePrompt() {
            const role = document.getElementById('builder-role').value.trim() || '[ระบุตำแหน่ง/บทบาท]';
            const task = document.getElementById('builder-task').value.trim() || '[ระบุงานที่ต้องการให้ AI ทำ]';
            const context = document.getElementById('builder-context').value.trim() || '[ระบุเรื่อง วัน เวลา สถานที่ วัตถุประสงค์]';
            const format = document.getElementById('builder-format').value.trim() || '[ระบุรูปแบบภาษาราชการและโครงสร้างผลลัพธ์]';

            // Check for potential 13-digit Thai ID or 10-digit phone number (PDPA Guard)
            const idRegex = /\b\d{13}\b|\b\d-\d{4}-\d{5}-\d{2}-\d\b|\b0[689]\d{8}\b/;
            const pdpaWarning = document.getElementById('pdpa-warning');
            if (idRegex.test(context)) {
                pdpaWarning.classList.remove('hidden');
            } else {
                pdpaWarning.classList.add('hidden');
            }

            const finalPrompt = `สวมบทบาทเป็น: ${role}\n\nงานที่ต้องการให้ทำ: ${task}\n\nบริบทและข้อมูลสำคัญ:\n${context}\n\nรูปแบบภาษาและผลลัพธ์ที่ต้องการ:\n${format}`;
            document.getElementById('builder-output-box').textContent = finalPrompt;
        }

        function copyGeneratedPrompt() {
            const text = document.getElementById('builder-output-box').textContent;
            copyToClipboard(text, 'คัดลอก Prompt จากเครื่องมือสร้างเรียบร้อยแล้ว!');
        }

        // ==========================================
        // 7. POST-TEST QUIZ LOGIC
        // ==========================================
        function renderQuiz() {
            const container = document.getElementById('quiz-questions-container');
            container.innerHTML = quizQuestions.map((item, qIdx) => `
                <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-3" id="quiz-block-${qIdx}">
                    <h4 class="font-heading font-bold text-slate-900 text-base">${item.q}</h4>
                    <div class="space-y-2">
                        ${item.options.map((opt, oIdx) => `
                            <label class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:border-blue-400 cursor-pointer transition">
                                <input type="radio" name="quiz-q-${qIdx}" value="${oIdx}" onchange="selectQuizAnswer(${qIdx}, ${oIdx})" class="w-4 h-4 text-blue-600 focus:ring-blue-500">
                                <span class="text-sm text-slate-700">${opt}</span>
                            </label>
                        `).join('')}
                    </div>
                    <div id="quiz-exp-${qIdx}" class="hidden p-3.5 rounded-xl text-xs leading-relaxed"></div>
                </div>
            `).join('');
        }

        function selectQuizAnswer(qIdx, oIdx) {
            userQuizAnswers[qIdx] = oIdx;
        }

        function submitQuiz() {
            let score = 0;
            quizQuestions.forEach((item, qIdx) => {
                const expEl = document.getElementById(`quiz-exp-${qIdx}`);
                const selected = userQuizAnswers[qIdx];
                expEl.classList.remove('hidden');

                if (selected === item.correct) {
                    score++;
                    expEl.className = "p-3.5 rounded-xl text-xs leading-relaxed bg-emerald-100/80 text-emerald-950 border border-emerald-300";
                    expEl.innerHTML = `<strong>ถูกต้อง!</strong> ${item.explanation}`;
                } else {
                    expEl.className = "p-3.5 rounded-xl text-xs leading-relaxed bg-rose-100/80 text-rose-950 border border-rose-300";
                    expEl.innerHTML = `<strong>คำตอบที่ถูกต้องคือ: ${item.options[item.correct]}</strong><br>${item.explanation}`;
                }
            });

            const banner = document.getElementById('quiz-score-banner');
            banner.classList.remove('hidden');
            banner.innerHTML = `คะแนนของคุณ: <span class="text-lg font-bold text-emerald-700">${score} / ${quizQuestions.length} คะแนน</span> (${Math.round((score/quizQuestions.length)*100)}%) — ${score >= 4 ? 'ยอดเยี่ยม! คุณพร้อมนำ AI ไปประยุกต์ใช้ในหน่วยงานอย่างปลอดภัยแล้ว' : 'แนะนำให้ทบทวนเนื้อหาโครงสร้าง Prompt และข้อควรระวัง PDPA อีกครั้ง'}`;
            showToast(`ตรวจคำตอบเรียบร้อย! คุณได้ ${score}/${quizQuestions.length} คะแนน`);
        }

        function resetQuiz() {
            userQuizAnswers = {};
            document.getElementById('quiz-score-banner').classList.add('hidden');
            renderQuiz();
        }

        // ==========================================
        // 8. CLIPBOARD & TOAST UTILITIES
        // ==========================================
        function copyCurrentStructure() {
            const mod = workshopsData[currentModuleIndex];
            const text = `${mod.structureTitle}\n` + mod.structureItems.map(i => `- ${i.label}: ${i.text}`).join('\n');
            copyToClipboard(text, 'คัดลอกโครงสร้าง Prompt เรียบร้อยแล้ว!');
        }

        function copyTextDecode(encodedStr, customMsg = 'คัดลอกคำสั่ง Prompt เรียบร้อยแล้ว!') {
            const text = decodeURIComponent(encodedStr);
            copyToClipboard(text, customMsg);
        }

        function copyToClipboard(text, message) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast(message);
            } catch (err) {
                showToast('ไม่สามารถคัดลอกได้ กรุณาเลือกข้อความแล้วกด Ctrl+C');
            }
            document.body.removeChild(textarea);
        }

        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Initialize on load
        window.onload = initApp;
    </script>
</body>
</html>