<!DOCTYPE html>
<html lang="th" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI สำหรับงานราชการและ อปท. - ระบบการเรียนการสอนออนไลน์</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Sarabun & Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Sarabun', 'sans-serif'],
                        heading: ['Prompt', 'sans-serif'],
                    },
                    colors: {
                        gov: {
                            50: '#f0f5ff',
                            100: '#e0eafc',
                            500: '#2563eb',
                            600: '#1d4ed8',
                            700: '#1e40af',
                            800: '#1e3a8a',
                            900: '#0f172a',
                            gold: '#d97706',
                            goldLight: '#fef3c7'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Sarabun', sans-serif;
        }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Prompt', sans-serif;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .presentation-zoom {
            font-size: 1.125rem;
        }
        .presentation-zoom h2 {
            font-size: 2rem;
        }
        .presentation-zoom .prompt-box {
            font-size: 1.15rem;
            line-height: 1.8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-blue-600 selection:text-white">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-3 bg-slate-900 text-white px-5 py-3.5 rounded-xl shadow-2xl border border-slate-700">
        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400 shrink-0"></i>
        <span id="toast-message" class="font-medium text-sm">คัดลอกคำสั่ง Prompt เรียบร้อยแล้ว!</span>
    </div>

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-40 bg-gov-900 text-white shadow-lg border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            <!-- Brand / Title -->
            <div class="flex items-center gap-3">
                <button id="mobile-menu-btn" onclick="toggleMobileSidebar()" class="lg:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center shadow-md shrink-0">
                    <i data-lucide="landmark" class="w-6 h-6 text-slate-950"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-heading font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">หลักสูตรปฏิบัติการ อปท.</span>
                        <span class="hidden sm:inline-block text-xs text-slate-400">พ.ศ. 2569</span>
                    </div>
                    <h1 class="font-heading font-bold text-base sm:text-lg text-white truncate max-w-[240px] sm:max-w-md md:max-w-xl">
                        การประยุกต์ใช้ AI เพื่อยกระดับการทำงานของ อปท.
                    </h1>
                </div>
            </div>

            <!-- Right Actions: Search, Tools & Presentation Mode -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Progress Indicator -->
                <div class="hidden md:flex items-center gap-2 bg-slate-800/90 px-3 py-1.5 rounded-lg border border-slate-700">
                    <div class="text-xs text-slate-300 font-heading">ความคืบหน้า:</div>
                    <div class="w-24 h-2 bg-slate-700 rounded-full overflow-hidden">
                        <div id="progress-bar" class="h-full bg-emerald-500 transition-all duration-500" style="width: 14%"></div>
                    </div>
                    <span id="progress-text" class="text-xs font-bold text-emerald-400">1/7</span>
                </div>

                <!-- Link to Trainer Guide -->
                <a href="trainer_guide.html" target="_blank" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-heading font-medium bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 transition" title="เปิดคู่มือวิทยากรและผู้ช่วยสอน">
                    <i data-lucide="book-open-check" class="w-4 h-4 text-amber-400"></i>
                    <span class="hidden sm:inline">คู่มือวิทยากร</span>
                </a>

                <!-- Link to Presentation Slides -->
                <a href="slides.html" target="_blank" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-heading font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition" title="เปิดชุดสไลด์บรรยาย 16:9 สำหรับวิทยากร">
                    <i data-lucide="presentation" class="w-4 h-4 text-amber-400"></i>
                    <span class="hidden sm:inline">สไลด์บรรยาย (Slides)</span>
                </a>

                <!-- Link to Handout -->
                <a href="handout.html" target="_blank" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-heading font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition" title="เปิดเอกสารสรุปและใบงานฝึกปฏิบัติ พิมพ์ A4">
                    <i data-lucide="file-text" class="w-4 h-4 text-emerald-400"></i>
                    <span class="hidden sm:inline">เอกสารสรุป (Handout)</span>
                </a>

                <!-- Interactive Prompt Builder Button -->
                <button onclick="switchMainView('builder')" id="btn-view-builder" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-heading font-medium bg-amber-500 hover:bg-amber-400 text-slate-950 transition shadow-sm">
                    <i data-lucide="wand-2" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">เครื่องมือสร้าง Prompt</span>
                </button>

                <!-- Quiz / Post-Test Button -->
                <button onclick="switchMainView('quiz')" id="btn-view-quiz" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-heading font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
                    <i data-lucide="award" class="w-4 h-4 text-amber-400"></i>
                    <span class="hidden sm:inline">แบบทดสอบ (Post-Test)</span>
                </button>

                <!-- Presentation Mode Toggle (For Instructor) -->
                <button onclick="togglePresentationMode()" id="presentation-btn" title="โหมดบรรยายสำหรับวิทยากร (ขยายตัวอักษรและซ่อนเมนู)" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition">
                    <i data-lucide="projector" class="w-5 h-5"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Layout Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col lg:flex-row gap-6 items-start">

            <!-- Sidebar Navigation (Curriculum Modules) -->
            <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-80 bg-white shadow-2xl lg:shadow-sm lg:static lg:w-80 lg:block transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out rounded-none lg:rounded-2xl border-r lg:border border-slate-200 overflow-y-auto max-h-screen lg:max-h-[calc(100vh-6rem)] shrink-0">
                <!-- Mobile Header inside Sidebar -->
                <div class="lg:hidden p-4 bg-gov-900 text-white flex items-center justify-between">
                    <span class="font-heading font-bold">สารบัญหลักสูตรอบรม</span>
                    <button onclick="toggleMobileSidebar()" class="p-1 rounded-lg text-slate-300 hover:text-white">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <!-- Search Prompts Box -->
                <div class="p-4 border-b border-slate-100 bg-slate-50/50">
                    <div class="relative">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="search-input" oninput="handleSearch(this.value)" placeholder="ค้นหาหัวข้อ หรือ Prompt..." class="w-full pl-9 pr-3 py-2 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>
                </div>

                <!-- Module List -->
                <div class="p-3 space-y-1.5" id="module-nav-list">
                    <!-- Rendered dynamically via JS -->
                </div>

                <!-- Quick Links & External Resources -->
                <div class="p-4 m-3 rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 text-white space-y-3">
                    <div class="flex items-center gap-2 text-amber-400 font-heading font-semibold text-sm">
                        <i data-lucide="folder-kanban" class="w-4 h-4"></i>
                        <span>เอกสารและไฟล์ประกอบ</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        ลิงก์ข้อมูลตัวอย่างงบประมาณ 5 ปีย้อนหลัง และสไลด์ประกอบการบรรยายสำหรับผู้เข้าอบรม
                    </p>
                    <div class="space-y-1.5 pt-1">
                        <a href="https://docs.google.com/spreadsheets/d/1pfRppNdzTYrVeci1uMBj5CvAWOxMKpehb-nfz5njiuo/edit?usp=sharing" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between text-xs bg-white/10 hover:bg-white/20 px-3 py-2 rounded-lg transition">
                            <span class="flex items-center gap-2 truncate"><i data-lucide="file-spreadsheet" class="w-3.5 h-3.5 text-emerald-400 shrink-0"></i> ข้อมูลงบประมาณ 5 ปี (Sheets)</span>
                            <i data-lucide="external-link" class="w-3 h-3 shrink-0 opacity-75"></i>
                        </a>
                        <a href="https://share.gemini.google/L8Qehce6khIy" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between text-xs bg-white/10 hover:bg-white/20 px-3 py-2 rounded-lg transition">
                            <span class="flex items-center justify-between gap-2 truncate"><i data-lucide="presentation" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i> สไลด์บรรยายจริยธรรม AI</span>
                            <i data-lucide="external-link" class="w-3 h-3 shrink-0 opacity-75"></i>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Mobile Overlay -->
            <div id="sidebar-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden backdrop-blur-xs"></div>

            <!-- Main Content Area -->
            <main id="main-content" class="flex-1 w-full min-w-0 space-y-6">
                
                <!-- VIEW 1: WORKSHOP MODULE CONTENT -->
                <div id="view-workshop" class="space-y-6">
                    <!-- Dynamic Module Header Banner -->
                    <div id="workshop-banner" class="bg-gradient-to-r from-gov-800 via-gov-700 to-blue-700 rounded-2xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden">
                        <div class="relative z-10 space-y-3">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span id="module-badge" class="px-3 py-1 rounded-full text-xs font-heading font-semibold bg-amber-400 text-slate-950 shadow-xs">
                                    Workshop 1
                                </span>
                                <button onclick="markModuleComplete()" id="btn-complete-module" class="flex items-center gap-1.5 text-xs font-heading px-3 py-1.5 rounded-lg bg-white/15 hover:bg-white/25 text-white backdrop-blur-xs transition">
                                    <i data-lucide="check-square" class="w-4 h-4"></i>
                                    <span>ทำเครื่องหมายว่าเรียนจบหัวข้อนี้แล้ว</span>
                                </button>
                            </div>
                            <h2 id="module-title" class="text-2xl sm:text-3xl font-heading font-bold leading-tight">
                                หลักการเขียน Prompt ให้ AI เข้าใจงานราชการ
                            </h2>
                            <p id="module-description" class="text-blue-100 text-sm sm:text-base max-w-3xl leading-relaxed">
                                เรียนรู้พื้นฐานสำคัญของการสื่อสารกับ AI (Prompt Engineering) โดยเน้นบริบทเฉพาะขององค์กรปกครองส่วนท้องถิ่น
                            </p>
                        </div>
                    </div>

                    <!-- Sub-navigation Tabs inside Workshop -->
                    <div class="flex overflow-x-auto gap-2 border-b border-slate-200 pb-px" id="workshop-tabs">
                        <button onclick="switchWorkshopTab('overview')" id="tab-overview" class="workshop-tab-btn flex items-center gap-2 px-4 py-2.5 font-heading font-medium text-sm rounded-t-xl border-b-2 border-blue-600 text-blue-700 bg-blue-50/60 whitespace-nowrap">
                            <i data-lucide="book-open" class="w-4 h-4"></i>
                            <span>เนื้อหาและโครงสร้าง Prompt</span>
                        </button>
                        <button onclick="switchWorkshopTab('prompts')" id="tab-prompts" class="workshop-tab-btn flex items-center gap-2 px-4 py-2.5 font-heading font-medium text-sm rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 hover:bg-slate-100 whitespace-nowrap">
                            <i data-lucide="terminal" class="w-4 h-4"></i>
                            <span>คลังตัวอย่าง Prompt</span>
                            <span id="prompt-count-badge" class="px-2 py-0.5 text-xs rounded-full bg-blue-100 text-blue-800 font-bold">7</span>
                        </button>
                        <button onclick="switchWorkshopTab('outputs')" id="tab-outputs" class="workshop-tab-btn flex items-center gap-2 px-4 py-2.5 font-heading font-medium text-sm rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 hover:bg-slate-100 whitespace-nowrap">
                            <i data-lucide="sparkles" class="w-4 h-4"></i>
                            <span>ผลลัพธ์ที่ได้จาก AI (Output)</span>
                        </button>
                    </div>

                    <!-- Tab Content 1: Overview & Standard Structure -->
                    <div id="content-overview" class="space-y-6">
                        <!-- Key Learning Points -->
                        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-4">
                            <div class="flex items-center gap-2.5 text-gov-800 font-heading font-bold text-lg">
                                <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                                    <i data-lucide="list-checks" class="w-5 h-5"></i>
                                </div>
                                <h3>1. เนื้อหาการเรียนรู้ประจำหัวข้อ</h3>
                            </div>
                            <ul id="module-topics-list" class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
                                <!-- Injected via JS -->
                            </ul>
                        </div>

                        <!-- Special Reference Section (Only shown in Workshop 1: 6 Types of Gov Docs) -->
                        <div id="special-gov-docs-section" class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-4 hidden">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
                                <div class="flex items-center gap-2.5 text-gov-800 font-heading font-bold text-lg">
                                    <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
                                        <i data-lucide="scroll-text" class="w-5 h-5"></i>
                                    </div>
                                    <h3>ประเภทของหนังสือราชการ 6 ชนิด (ตามระเบียบงานสารบรรณ พ.ศ. 2526)</h3>
                                </div>
                                <span class="text-xs text-slate-500 bg-slate-100 px-3 py-1 rounded-full font-medium">คลิกที่การ์ดเพื่อดู Prompt ของแต่ละประเภท</span>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="gov-doc-types-grid">
                                <!-- Rendered via JS -->
                            </div>
                        </div>

                        <!-- 1x1 Table: Prompt Structure -->
                        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-4">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2.5 text-gov-800 font-heading font-bold text-lg">
                                    <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center">
                                        <i data-lucide="cpu" class="w-5 h-5"></i>
                                    </div>
                                    <h3>โครงสร้าง Prompt มาตรฐาน (ตาราง 1x1)</h3>
                                </div>
                                <button onclick="copyCurrentStructure()" class="flex items-center gap-1.5 text-xs font-heading font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-700 transition">
                                    <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                    <span>คัดลอกโครงสร้าง</span>
                                </button>
                            </div>

                            <!-- 1x1 Table Format -->
                            <div class="border-2 border-indigo-200 rounded-xl overflow-hidden bg-indigo-50/40">
                                <div class="bg-indigo-900 text-white px-4 py-2.5 font-heading font-semibold text-sm flex items-center justify-between">
                                    <span id="structure-table-header">โครงสร้าง Prompt มาตรฐานสำหรับงานราชการ</span>
                                    <span class="text-xs bg-indigo-700 px-2 py-0.5 rounded text-indigo-200">สูตร 4 องค์ประกอบ</span>
                                </div>
                                <div id="structure-table-body" class="p-5 space-y-3 text-slate-800 leading-relaxed prompt-box">
                                    <!-- Injected via JS -->
                                </div>
                            </div>
                        </div>

                        <!-- Quick Navigation to Prompts Tab -->
                        <div class="flex justify-end">
                            <button onclick="switchWorkshopTab('prompts')" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-heading font-medium px-6 py-3 rounded-xl shadow-md hover:shadow-lg transition">
                                <span>ดูตัวอย่าง Prompt ทั้งหมดในหัวข้อนี้</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Tab Content 2: Prompt Examples (1x1 Table Style) -->
                    <div id="content-prompts" class="space-y-6 hidden">
                        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                                <div>
                                    <h3 class="font-heading font-bold text-lg text-slate-900 flex items-center gap-2">
                                        <i data-lucide="terminal" class="w-5 h-5 text-blue-600"></i>
                                        <span>ตารางตัวอย่าง Prompt พร้อมใช้งาน (1x1 Table)</span>
                                    </h3>
                                    <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                                        ผู้เรียนสามารถกดปุ่ม "คัดลอก Prompt" เพื่อนำไปวางใน Gemini, ChatGPT หรือ Claude ได้ทันที หรือกด "ทดลองปรับแต่ง" เพื่อเปลี่ยนข้อมูลให้ตรงกับหน่วยงานของตนเอง
                                    </p>
                                </div>
                            </div>

                            <!-- 1x1 Prompt Table Container -->
                            <div id="prompts-list-container" class="space-y-5">
                                <!-- Injected via JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Tab Content 3: AI Outputs (1x1 Table Style) -->
                    <div id="content-outputs" class="space-y-6 hidden">
                        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                                <div>
                                    <h3 class="font-heading font-bold text-lg text-slate-900 flex items-center gap-2">
                                        <i data-lucide="file-check-2" class="w-5 h-5 text-emerald-600"></i>
                                        <span>ตารางผลลัพธ์ที่ได้จาก AI (1x1 Table Output)</span>
                                    </h3>
                                    <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                                        ตัวอย่างผลลัพธ์มาตรฐานเมื่อใช้โครงสร้าง Prompt ที่กำหนด (เจ้าหน้าที่ควรตรวจสอบความถูกต้องตามหลัก Human-in-the-Loop ก่อนนำไปใช้งานจริง)
                                    </p>
                                </div>
                            </div>

                            <!-- 1x1 Outputs Container -->
                            <div id="outputs-list-container" class="space-y-6">
                                <!-- Injected via JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Module Pagination -->
                    <div class="flex items-center justify-between pt-4 border-t border-slate-200">
                        <button onclick="navigateModule(-1)" id="btn-prev-module" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 font-heading text-sm font-medium transition shadow-2xs disabled:opacity-40 disabled:pointer-events-none">
                            <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            <span>หัวข้อก่อนหน้า</span>
                        </button>
                        <button onclick="navigateModule(1)" id="btn-next-module" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gov-800 text-white hover:bg-gov-700 font-heading text-sm font-medium transition shadow-sm disabled:opacity-40 disabled:pointer-events-none">
                            <span>หัวข้อถัดไป</span>
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- VIEW 2: INTERACTIVE 4-ELEMENT PROMPT BUILDER (SANDBOX FOR STUDENTS) -->
                <div id="view-builder" class="space-y-6 hidden">
                    <div class="bg-gradient-to-r from-amber-500 via-amber-600 to-orange-600 rounded-2xl p-6 sm:p-8 text-white shadow-lg">
                        <div class="flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full text-xs font-heading font-bold bg-slate-950 text-amber-400">
                                Interactive Workshop Tool
                            </span>
                            <button onclick="switchMainView('workshop')" class="text-xs font-heading bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-lg flex items-center gap-1 transition">
                                <i data-lucide="arrow-left" class="w-4 h-4"></i> กลับสู่บทเรียน
                            </button>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-heading font-bold mt-3">
                            เครื่องมือฝึกสร้าง Prompt 4 องค์ประกอบ สำหรับงานราชการ อปท.
                        </h2>
                        <p class="text-amber-50 text-sm sm:text-base mt-1 max-w-3xl">
                            ทดลองกรอกข้อมูลตามภารกิจจริงของท่าน ระบบจะประกอบร่างเป็นคำสั่ง Prompt มาตรฐานตามระเบียบงานสารบรรณ พร้อมตรวจสอบความเสี่ยงด้านข้อมูลส่วนบุคคล (PDPA Check) ให้โดยอัตโนมัติ
                        </p>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <!-- Form Inputs -->
                        <div class="lg:col-span-7 bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-5">
                            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                <h3 class="font-heading font-bold text-slate-900 flex items-center gap-2">
                                    <i data-lucide="sliders" class="w-5 h-5 text-amber-600"></i>
                                    <span>กำหนดองค์ประกอบ Prompt ทั้ง 4 ส่วน</span>
                                </h3>
                                <button onclick="fillBuilderSample()" class="text-xs font-heading text-blue-600 hover:underline flex items-center gap-1">
                                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> โหลดข้อมูลตัวอย่าง
                                </button>
                            </div>

                            <!-- 1. Role -->
                            <div class="space-y-1.5">
                                <label class="block text-sm font-heading font-semibold text-slate-800">
                                    1. บทบาท (Role) <span class="text-xs font-normal text-slate-500">- คุณต้องการให้ AI สวมบทบาทเป็นตำแหน่งใด?</span>
                                </label>
                                <div class="flex gap-2 flex-wrap pb-1">
                                    <button type="button" onclick="setBuilderField('builder-role', 'นักจัดการงานทั่วไปชำนาญการ สังกัดสำนักปลัด')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">นักจัดการงานทั่วไปฯ</button>
                                    <button type="button" onclick="setBuilderField('builder-role', 'นักวิเคราะห์นโยบายและแผนชำนาญการ กองยุทธศาสตร์และงบประมาณ')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">นักวิเคราะห์นโยบายและแผนฯ</button>
                                    <button type="button" onclick="setBuilderField('builder-role', 'นักประชาสัมพันธ์ชำนาญการ ผู้ดูแลเพจและสื่อสารมวลชนของ อปท.')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">นักประชาสัมพันธ์ฯ</button>
                                    <button type="button" onclick="setBuilderField('builder-role', 'นักวิชาการคลังชำนาญการ กองคลัง')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">นักวิชาการคลังฯ</button>
                                </div>
                                <input type="text" id="builder-role" oninput="updateLivePrompt()" placeholder="เช่น นักจัดการงานทั่วไปชำนาญการ สังกัดสำนักปลัด เทศบาลตำบลเมืองใหม่" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            </div>

                            <!-- 2. Objective / Task -->
                            <div class="space-y-1.5">
                                <label class="block text-sm font-heading font-semibold text-slate-800">
                                    2. งานที่ต้องการให้ทำ (Objective / Task) <span class="text-xs font-normal text-slate-500">- ระบุประเภทเอกสารหรือชิ้นงาน</span>
                                </label>
                                <div class="flex gap-2 flex-wrap pb-1">
                                    <button type="button" onclick="setBuilderField('builder-task', 'ร่างหนังสือภายใน (บันทึกข้อความ) เสนอต่อนายกเทศมนตรีเพื่อขออนุมัติจัดโครงการ')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">ร่างบันทึกข้อความ</button>
                                    <button type="button" onclick="setBuilderField('builder-task', 'ร่างหนังสือราชการภายนอก (กระดาษตราครุฑ) เพื่อขอความอนุเคราะห์วิทยากร')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">ร่างหนังสือภายนอก</button>
                                    <button type="button" onclick="setBuilderField('builder-task', 'เขียนข่าวประชาสัมพันธ์สำหรับโพสต์ Facebook และ LINE OA ของหน่วยงาน')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">เขียนโพสต์ประชาสัมพันธ์</button>
                                    <button type="button" onclick="setBuilderField('builder-task', 'วิเคราะห์ SWOT Analysis และเสนอโครงการใหม่เพื่อบรรจุในแผนพัฒนาท้องถิ่น')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">วิเคราะห์ SWOT & ร่างโครงการ</button>
                                </div>
                                <input type="text" id="builder-task" oninput="updateLivePrompt()" placeholder="เช่น ร่างบันทึกข้อความขออนุมัติจัดโครงการ / สรุปหนังสือเวียน สถ." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            </div>

                            <!-- 3. Context & Details -->
                            <div class="space-y-1.5">
                                <label class="block text-sm font-heading font-semibold text-slate-800">
                                    3. บริบทและข้อมูลสำคัญ (Context) <span class="text-xs font-normal text-slate-500">- เรื่อง, วันเวลา, สถานที่, งบประมาณ, กลุ่มเป้าหมาย</span>
                                </label>
                                <textarea id="builder-context" rows="4" oninput="updateLivePrompt()" placeholder="ระบุรายละเอียด เช่น โครงการฝึกอบรม AI วันศุกร์ที่ 15 พ.ย. 2569 ณ ห้องประชุมเทศบาล กลุ่มเป้าหมาย 50 คน งบประมาณ 15,000 บาท (ระวัง: อย่าใส่เลขบัตรประชาชน 13 หลัก หรือชื่อ-เบอร์โทรจริงของประชาชน)" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
                                <!-- Real-time PDPA Guard Alert -->
                                <div id="pdpa-warning" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-start gap-2">
                                    <i data-lucide="shield-alert" class="w-4 h-4 text-rose-600 shrink-0 mt-0.5"></i>
                                    <div>
                                        <span class="font-bold">แจ้งเตือนความปลอดภัยข้อมูลส่วนบุคคล (PDPA Warning):</span>
                                        ตรวจพบตัวเลขที่คล้ายเลขบัตรประจำตัวประชาชน 13 หลัก หรือหมายเลขโทรศัพท์ในข้อความของท่าน โปรดแทนที่ด้วย <code class="bg-rose-100 px-1 rounded">[ปกปิดข้อมูล]</code> ก่อนนำไปป้อนใน AI สาธารณะ
                                    </div>
                                </div>
                            </div>

                            <!-- 4. Format & Tone -->
                            <div class="space-y-1.5">
                                <label class="block text-sm font-heading font-semibold text-slate-800">
                                    4. รูปแบบภาษาและผลลัพธ์ (Format & Tone)
                                </label>
                                <div class="flex gap-2 flex-wrap pb-1">
                                    <button type="button" onclick="setBuilderField('builder-format', 'ใช้ภาษาราชการที่ถูกต้องตามระเบียบสำนักนายกรัฐมนตรีว่าด้วยงานสารบรรณ พ.ศ. 2526 แบ่งเนื้อหาเป็น 1. เรื่องเดิม 2. ข้อเท็จจริง 3. ข้อพิจารณาและข้อเสนอ')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">รูปแบบบันทึกข้อความ 3 ส่วน</button>
                                    <button type="button" onclick="setBuilderField('builder-format', 'สรุปเป็นตารางเปรียบเทียบชัดเจน พร้อมรายการ Checklist ขั้นตอนการปฏิบัติงานสำหรับเจ้าหน้าที่')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">ตารางสรุป + Checklist</button>
                                    <button type="button" onclick="setBuilderField('builder-format', 'ภาษาเป็นกันเองแต่สุภาพ เข้าใจง่าย มี Emoji ประกอบ พร้อมโครงร่างสำหรับทำภาพ Infographic')" class="text-xs bg-slate-100 hover:bg-blue-50 hover:text-blue-700 px-2.5 py-1 rounded-md border border-slate-200 transition">ภาษาประชาสัมพันธ์ + Infographic</button>
                                </div>
                                <input type="text" id="builder-format" oninput="updateLivePrompt()" placeholder="เช่น ใช้ภาษาราชการตามระเบียบงานสารบรรณ แบ่งเป็น 1. เรื่องเดิม 2. ข้อเท็จจริง 3. ข้อเสนอ" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            </div>
                        </div>

                        <!-- Live Generated Prompt Preview (1x1 Table) -->
                        <div class="lg:col-span-5 space-y-4">
                            <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-xl border border-slate-800 space-y-4 sticky top-24">
                                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                        <h3 class="font-heading font-bold text-base">Prompt ที่พร้อมนำไปใช้งาน (1x1)</h3>
                                    </div>
                                    <button onclick="resetBuilder()" class="text-xs text-slate-400 hover:text-white">ล้างข้อมูล</button>
                                </div>

                                <div id="builder-output-box" class="bg-slate-950/90 border border-slate-800 rounded-xl p-4 text-sm text-slate-200 leading-relaxed whitespace-pre-line min-h-[220px]">
                                    <!-- Live generated prompt -->
                                </div>

                                <div class="pt-2 space-y-2.5">
                                    <button onclick="copyGeneratedPrompt()" class="w-full py-3 px-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-heading font-bold rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                                        <i data-lucide="copy" class="w-4 h-4"></i>
                                        <span>คัดลอกคำสั่ง Prompt นี้</span>
                                    </button>
                                    <div class="grid grid-cols-2 gap-2">
                                        <a href="https://gemini.google.com/" target="_blank" rel="noopener noreferrer" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-heading rounded-lg flex items-center justify-center gap-1.5 transition border border-slate-700">
                                            <span>เปิด Google Gemini</span>
                                            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                        </a>
                                        <a href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-heading rounded-lg flex items-center justify-center gap-1.5 transition border border-slate-700">
                                            <span>เปิด ChatGPT</span>
                                            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- VIEW 3: INTERACTIVE POST-TEST QUIZ -->
                <div id="view-quiz" class="space-y-6 hidden">
                    <div class="bg-gradient-to-r from-emerald-800 via-teal-800 to-cyan-800 rounded-2xl p-6 sm:p-8 text-white shadow-lg">
                        <div class="flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full text-xs font-heading font-bold bg-emerald-300 text-slate-950">
                                การวัดผลและทบทวนองค์ความรู้ (Post-Test)
                            </span>
                            <button onclick="switchMainView('workshop')" class="text-xs font-heading bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-lg flex items-center gap-1 transition">
                                <i data-lucide="arrow-left" class="w-4 h-4"></i> กลับสู่บทเรียน
                            </button>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-heading font-bold mt-3">
                            แบบทดสอบหลังการอบรม: การใช้ AI ในงานราชการและ อปท. อย่างมืออาชีพและปลอดภัย
                        </h2>
                        <p class="text-emerald-100 text-sm sm:text-base mt-1 max-w-3xl">
                            ทดสอบความเข้าใจเรื่องโครงสร้าง Prompt 4 องค์ประกอบ, ระเบียบงานสารบรรณ, การคุ้มครองข้อมูลส่วนบุคคล (PDPA) และการตรวจสอบความถูกต้องของข้อมูล (Human-in-the-Loop)
                        </p>
                    </div>

                    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-6">
                        <div id="quiz-questions-container" class="space-y-6">
                            <!-- Rendered via JS -->
                        </div>

                        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div id="quiz-score-banner" class="hidden flex-1 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 font-heading">
                                <!-- Score summary -->
                            </div>
                            <div class="flex items-center gap-3 self-end sm:self-center">
                                <button onclick="resetQuiz()" class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-heading text-sm font-medium transition">
                                    ทำแบบทดสอบใหม่
                                </button>
                                <button onclick="submitQuiz()" class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-heading text-sm font-bold shadow-md transition">
                                    ตรวจคำตอบและดูเฉลย
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- JavaScript Application Data & Logic -->
    <script>
        // ==========================================
        // 1. CURRICULUM DATA (All 7 Modules from Doc)
        // ==========================================
        const workshopsData = [
            {
                id: 'ws1',
                code: 'Workshop 1',
                shortTitle: 'หลักการเขียน Prompt งานราชการ',
                title: 'Workshop 1 : หลักการเขียน Prompt ให้ AI เข้าใจงานราชการ',
                icon: 'pen-tool',
                description: 'เรียนรู้พื้นฐานสำคัญของการสื่อสารกับ AI (Prompt Engineering) โดยเน้นบริบทเฉพาะขององค์กรปกครองส่วนท้องถิ่น ผู้เข้าอบรมจะได้ฝึกการวางโครงสร้างคำสั่ง 4 องค์ประกอบหลัก เพื่อให้ AI เข้าใจธรรมเนียมปฏิบัติ คำราชาศัพท์ หรือระดับภาษาทางการที่ใช้ในหนังสือราชการไทย พร้อมเทคนิคการสั่งปรับแก้ (Follow-up Prompt) เมื่อผลลัพธ์แรกยังไม่ตรงตามต้องการ',
                topics: [
                    'การกำหนดบทบาท (Role) วัตถุประสงค์ (Objective) รูปแบบภาษา (Tone) และผลลัพธ์ที่ต้องการ (Output)',
                    'ประเภทของหนังสือราชการทั้ง 6 ชนิด ตามระเบียบสำนักนายกรัฐมนตรีว่าด้วยงานสารบรรณ พ.ศ. 2526',
                    'การเขียน Prompt สำหรับหนังสือภายนอก บันทึกข้อความ หนังสือประทับตรา คำสั่ง ประกาศ และรายงานการประชุม',
                    'การปรับแก้คำสั่ง (Iterative Prompting) เพื่อให้ได้ผลลัพธ์ที่ถูกต้องและใช้งานได้จริงตามระเบียบงานสารบรรณ'
                ],
                hasGovDocsSection: true,
                govDocTypes: [
                    {
                        num: '1. หนังสือภายนอก',
                        desc: 'ติดต่อระหว่างส่วนราชการ หรือหน่วยงานภายนอก/บุคคลภายนอก',
                        paper: 'กระดาษตราครุฑ (ครุฑสูง 3 ซม.) ลงนามโดยหัวหน้าส่วนราชการ',
                        promptIndex: 0
                    },
                    {
                        num: '2. หนังสือภายใน',
                        desc: 'ติดต่อภายในกระทรวง กรม จังหวัดเดียวกัน หรือภายใน อปท.',
                        paper: 'กระดาษบันทึกข้อความ (ครุฑสูง 1.5 ซม.) แบบพิธีน้อยกว่าหนังสือภายนอก',
                        promptIndex: 1
                    },
